# Required if using OpenAI embeddings or LLM
OPENAI_API_KEY=

# Required for NRC ADAMS case document fetching
# Sign up at https://adams-api-developer.nrc.gov/
NRC_ADAMS_API_KEY=

# Optional: ScaleDown API key for prompt compression (set RAG_COMPRESSION__ENABLED=true to activate)
SCALEDOWN_API_KEY=

# Optional: Qdrant connection (for Docker Compose, use http://qdrant:6333)
# QDRANT_URL=http://localhost:6333

# Optional: override settings.toml values via env vars
# Convention: RAG_<SECTION>__<KEY>=<value>
# Examples:
# RAG_VECTORSTORE__BACKEND=qdrant
# RAG_VECTORSTORE__QDRANT_URL=http://qdrant:6333
# RAG_RETRIEVAL__TOP_K=12
# RAG_RERANK__ENABLED=false
