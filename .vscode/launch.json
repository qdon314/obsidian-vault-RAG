{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Python: ask script (with args)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/ask.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--index",
        "obsidian_index",
        "--q",
        "How would you describe scaled dot-product attention?",
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: build script (with args)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/scripts/build_index.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--corpus",
        "/Users/quentindonnelly/Documents/Personal & Professional",
        "--index-name",
        "obsidian_proposition_index",
        "--extensions",
        ".md",
        "--use-dummy-embeddings",
        "--cache-embeddings",
      ],
        "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: eval script (with args)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/scripts/run_eval.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--queries",
        "eval/datasets/generated_queries.jsonl",
      ],
        "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python:Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${file}"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
