aws_region   = "us-east-1"
project_name = "obsidian-rag"
app_image_tag = "git-sha-or-release-tag"

# Provide secrets via environment, not tfvars:
# export TF_VAR_openai_api_key='sk-...'
# export TF_VAR_db_password='...'

# Find these with: aws ec2 describe-subnets --query 'Subnets[].SubnetId'
subnet_ids = ["subnet-xxxxxxxx"]

# Security groups are managed by Terraform by default.
# Optionally provide *additional* SG IDs to attach:
# ecs_security_group_ids = ["sg-extra-ecsxxxxxxxx"]
# rds_security_group_ids = ["sg-extra-rdsxxxxxxxx"]

# Scale to zero by default (set to 1 to run)
app_desired_count    = 0
qdrant_desired_count = 0
worker_desired_count = 0

# Worker sizing
worker_cpu    = 256
worker_memory = 512

# Optional: separate corpus bucket (defaults to <project>-artifacts when empty)
# corpus_bucket_name = "obsidian-rag-corpus"
corpus_s3_prefix = "corpus"
chunk_s3_prefix  = "chunks"

# RDS + SQS for distributed ingestion
db_username          = "rag"
db_instance_class    = "db.t4g.micro"
sqs_visibility_timeout = 300
sqs_max_receive_count  = 5

# Orchestrator sizing
orchestrator_cpu    = 256
orchestrator_memory = 512

# Query/eval sizing
query_eval_cpu    = 256
query_eval_memory = 512

# S3 prefixes
eval_s3_prefix      = "eval"
manifests_s3_prefix = "manifests"
